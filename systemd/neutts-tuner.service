[Unit]
Description=NeuTTS voice tuning web server (port 8090)
After=default.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/home/jetson
Environment=NEU_BACKBONE_DEVICE=gpu
Environment=NEU_CODEC_DEVICE=cuda
Environment=LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/lib/aarch64-linux-gnu
Environment=PATH=/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=-/usr/bin/pkill -9 -f neutts_server.py
ExecStart=/home/jetson/neutts-venv/bin/python3 /home/jetson/avatar-voice/neutts_server.py
StandardOutput=append:/tmp/neuserver.log
StandardError=append:/tmp/neuserver.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
